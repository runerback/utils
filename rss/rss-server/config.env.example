# Copy this file to config.env, fill in every required value, then run:
#   sudo ./deploy.sh --config config.env install
#
# This file is sourced by Bash. Keep it readable only by trusted administrators.

# Public hostnames. They must be different and must already point to the server.
FRESHRSS_HOST="rss.example.com"
RSS_BRIDGE_HOST="bridge.example.com"

# Exact stable release tags, never "latest", a branch name, or a moving ref.
# FreshRSS tags normally look like "1.2.3".
FRESHRSS_VERSION=""
# RSS-Bridge tags normally use the project's dated release-tag format.
RSS_BRIDGE_VERSION=""

# Optional SHA-256 for the GitHub source archives. Strongly recommended when
# you have obtained the expected values from a trusted release process.
# Leave empty to rely on HTTPS only; the installer will print a warning.
FRESHRSS_SHA256=""
RSS_BRIDGE_SHA256=""
