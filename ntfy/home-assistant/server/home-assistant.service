[Unit]
Description=Home Assistant Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/home-assistant

# Uvicorn binds on localhost; nginx faces the public
Environment="HOME_ASSISTANT_HOST=127.0.0.1"

# Port uvicorn listens on; nginx proxies to this
Environment="HOME_ASSISTANT_PORT=8000"

# URL of the running ntfy server on the target machine
Environment="NTFY_BASE_URL=http://localhost"

# SQLite database path
Environment="DATABASE_PATH=/var/lib/home-assistant/home-assistant.db"

# Application log file path
Environment="LOG_PATH=/var/log/home-assistant/app.log"

# Required: a long random string used to sign session cookies
Environment="SECRET_KEY="

ExecStart=/opt/home-assistant/.venv/bin/uvicorn home_assistant.main:app \
    --host ${HOME_ASSISTANT_HOST} \
    --port ${HOME_ASSISTANT_PORT} \
    --workers 1 \
    --proxy-headers \
    --access-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
