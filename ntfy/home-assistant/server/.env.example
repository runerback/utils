HOME_ASSISTANT_HOST=0.0.0.0
HOME_ASSISTANT_PORT=5000
SECRET_KEY=change-me-in-production
NTFY_BASE_URL=http://localhost
DATABASE_PATH=/var/lib/home-assistant/home-assistant.db
LOG_PATH=/var/log/home-assistant/app.log

# MQTT broker advertised to provisioned devices.
MQTT_HOST=localhost
MQTT_PORT=1883

# Mosquitto CLI aliases/commands. If these are shell aliases on the server that
# already include host/port/cafile/credentials, just set the alias name here.
MOSQUITTO_PUB_BIN=mosquitto_pub
MOSQUITTO_SUB_BIN=mosquitto_sub
MOSQUITTO_CTRL_BIN=mosquitto_ctrl

# Optional: serial port of the MSU mini USB screen (e.g. /dev/ttyACM0).
# If unset, the QR code is generated but not shown locally.
MSU_SCREEN_PORT=
