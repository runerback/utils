[Unit]
Description=ntfy Manager Web UI
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ntfy-mgr

# Uvicorn binds on localhost; nginx faces the public
Environment="NTFY_MGR_HOST=127.0.0.1"

# Port uvicorn listens on; nginx proxies to this
Environment="NTFY_MGR_PORT=8000"

# URL of the running ntfy server used to validate admin credentials
Environment="NTFY_BASE_URL=http://localhost"

# Path to the ntfy binary; leave as "ntfy" if it is on PATH
Environment="NTFY_CLI=ntfy"

# Required: a long random string used by Flask to sign session cookies
Environment="SECRET_KEY="

ExecStart=/opt/ntfy-mgr/.venv/bin/uvicorn app:asgi_app \
    --host ${NTFY_MGR_HOST} \
    --port ${NTFY_MGR_PORT} \
    --workers 1 \
    --proxy-headers \
    --access-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
