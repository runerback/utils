<Window x:Class="svn.viewer.loader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:svn.viewer.loader"
        mc:Ignorable="d" d:Width="300" d:Height="300"
        WindowState="Maximized" WindowStyle="SingleBorderWindow"
        Icon="/assets/SVNLogo.ico"
        Title="{Binding Title, Mode=OneWay}">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <local:UriConverter x:Key="uriConverter" />
        <local:TabHeaderWidthConverter TabsCount="2" x:Key="tabHeaderWidthConverter" />
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width">
                <Setter.Value>
                    <Binding 
                        Path="ActualWidth"
                        Mode="OneWay" 
                        RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type TabControl}}"
                        Converter="{StaticResource tabHeaderWidthConverter}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl TabIndex="0">
        <TabItem Header="UI" TabIndex="0">
            <wv2:WebView2
                Source="{Binding UIAddress, Mode=OneWay, Converter={StaticResource uriConverter}}"
                CreationProperties="{Binding WebviewProps, Mode=OneWay}" />
        </TabItem>
        <TabItem Header="Services" TabIndex="1">
            <wv2:WebView2
                Source="{Binding ServiceAddress, Mode=OneWay, Converter={StaticResource uriConverter}}"
                CreationProperties="{Binding WebviewProps, Mode=OneWay}" />
        </TabItem>
    </TabControl>
</Window>